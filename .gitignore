.vercel
.env*
node_modules/
# local-data/ is tracked on purpose: the live database (db.json) is version
# controlled so that a change of data shows up as a modified file, which is the
# reminder to take a backup.
# Local safety copies and the old Neon production dumps are never committed.
local-data/db.backup-*.json
local-data/backups/
local-data/prod-*.json
local-data/prod-backups/
hp-inventory-image.tar
*.bak_*
*.bak
ims-server.log
vercel-deploy*.log
*.tmp
