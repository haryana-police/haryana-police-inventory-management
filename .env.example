# Optional local settings. Copy to .env.local and edit.
# Everything here is OPTIONAL - the app runs fully offline with zero config.

# ---------- IMS Agent (optional) ----------
# The IMS Agent works offline out of the box using its built-in local NLU.
# Add a Google Gemini key only if you want the smarter cloud model.
# NEVER commit a real key - .env.local is gitignored.
# GEMINI_API_KEY=AIza...your-key...

# Optional: model id override (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
